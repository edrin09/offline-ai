# ============================================================
# 本地模型部署 — 可调参数（switch-model.bat 与 main/log_filter.py 共用）
# 改参数只改本文件，不要改代码里的硬编码值
#
# 写法：每行 KEY=VALUE，说明写在它的上一行（# 开头，只能是整行注释）
#       值不要加引号、行尾不要留空格、键名前不要留空格、值里不要放 "="
#       换行必须是 Windows(CRLF)：cmd 的 for /f 只认 CRLF，用 LF 存会让整个文件读不进来
#       编码 UTF-8（无 BOM）；环境变量同名时优先于本文件
# 优先级：环境变量 > 本文件 > 代码里的兜底默认值
# ============================================================

# ---------------------------- 路径 ----------------------------

# llama-server.exe 所在目录；同时作为新窗口的工作目录（start /D）
SERVER_DIR=C:\OfflineAI\main\ikllama

# 引擎可执行文件名（只写名字，自动拼在 SERVER_DIR 下）；换回官方 llama.cpp 改这里
SERVER_EXE=llama-server.exe

# GGUF 模型权重目录；下面三个模型文件名都拼在这里
MODELS_DIR=C:\OfflineAI\main\models

# KV 缓存槽目录（--slot-save-path）：存上下文检查点，重启后首轮直接命中省 prefill
SLOTS_DIR=C:\OfflineAI\main\slots

# 日志目录：log_filter.py 按天写 llama-YYYY-MM-DD.log
LOGS_DIR=C:\OfflineAI\logs

# 日志美化器脚本路径（控制台中文提示 + 落盘过滤规则，见 ADR-11）
LOG_FILTER=C:\OfflineAI\main\log_filter.py

# 跑美化器用的 Python 解释器（绝对路径；换成系统自带 python 也能用）
PYTHON=C:\uv\py3.14.8\Scripts\python.exe

# ------------------- 模型文件（只写文件名） -------------------

# 按 1 启动：写/改代码、补全、tool-calling、Agent 用；快 2.15x、省 2.4x token，无视觉
MODEL_CODER=Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf

# 按 2 启动：读长文/问答/总结 + 高速纯文本通用位（2026-10-20 起）
# Ling-mini-2.0：MoE 16B/激活1.4B，TG 30/27/23 @3K/7.7K/12.2K，无视觉、无思考税（benchmarks.md 十一节）
MODEL_OFFICE=Ling-mini-2.0-Q4_K_M.gguf

# 办公模型的视觉投影层（--mmproj）：删掉这行/留空就不再支持看图
# Ling-mini 是纯文本模型，此位必须留空
MMPROJ_OFFICE=

# 服务端思考税开关（-rea）：off 全局关思考，留空=模型默认。实测 off 后 37 token 直出答案
REASONING=off

# ------------ 服务与推理参数（改动前先读 docs/architecture.md） ------------

# 监听地址：127.0.0.1 只允许本机访问（同一台机器上的编辑器正常连）
HOST=127.0.0.1

# 服务端口：客户端对接 http://127.0.0.1:<PORT>/v1；启动前自动杀掉占用该端口的进程
PORT=9527

# 上下文长度：16K 配置、实用守 12K；再往上（≥15K）实测崩速卡死（ADR-3）
CTX_SIZE=16384

# CPU 线程数：8 个物理核；写 12（超线程）反而是负优化，见 pitfalls.md
THREADS=8

# 逻辑批大小（-b）：一批处理的 token 上限，配合 UBATCH 使用
BATCH=2048

# 物理批大小（-ub）：单次前向的 token 上限；调大省时但更吃内存
UBATCH=512

# Flash Attention 开关（on/off）：CPU 上也有收益，保持 on
FLASH_ATTN=on

# K 缓存量化（-ctk）：q8_0 把 KV 读取量砍半，长上下文提速（ADR-5）
CACHE_TYPE_K=q8_0

# V 缓存量化（-ctv）：含义同 K，要和 K 一起改
CACHE_TYPE_V=q8_0

# CPU 侧 KV 缓存预留（-cram），ik_llama 专用参数，默认 2048
CRAM=2048

# ------------------- 启动行为与日志 -------------------

# 清端口的等待上限（秒）：杀完占用进程后最多等这么久，超时即中止启动
PORT_WAIT_SEC=15

# 美化日志的文件名前缀：LOGS_DIR\llama-YYYY-MM-DD.log（满 LOG_MAX_MB 滚动为 _1/_2…）
LOG_PREFIX=llama

# 美化日志单个文件的大小上限（MB）：写满自动开新文件，同日重启追加不覆盖
LOG_MAX_MB=5
